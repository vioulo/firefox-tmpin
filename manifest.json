{
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "version": "0.5.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "zh_CN",
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-tmp-pin@vioulo.com",
      "strict_min_version": "100.0",
      "data_collection_permissions": {
        "required": ["none"],
        "description": "This extension stores user's pinned pages and groups in browser storage for synchronization across devices. No personal data is collected or shared with third parties."
      }
    }
  },
  "permissions": [
    "storage",
    "contextMenus",
    "tabs"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon_16.png",
      "32": "icons/icon_32.png",
      "48": "icons/icon_48.png",
      "128": "icons/icon_128.png"
    },
    "default_title": "__MSG_extensionName__"
  },
  "icons": {
    "16": "icons/icon_16.png",
    "32": "icons/icon_32.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  }
}